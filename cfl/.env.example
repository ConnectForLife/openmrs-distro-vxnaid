# Tomcat Server configuration
TOMCAT_PORT=80
TOMCAT_DEV_PORT=8080
TOMCAT_DEV_DEBUG_PORT=1044
JAVA_OPTS="-Dfile.encoding=UTF-8 -server -Xmx16g -Xms2g -XX:MaxPermSize=1024m -XX:MaxPermSize=1024m"
CATALINA_OPTS="-DOPENMRS_INSTALLATION_SCRIPT=/usr/local/tomcat/openmrs-server.properties -DOPENMRS_APPLICATION_DATA_DIRECTORY=/usr/local/tomcat/.OpenMRS"

# Database container configuration (docker-compose.db.yml)
MYSQL_DEV_PORT=3306
DB_ROOT_PASSWORD=Admin123

# OpenMRS application configuration
DB_DATABASE=openmrs
DB_HOST=db
DB_USERNAME=openmrs
DB_PASSWORD=Admin123
DB_CREATE_TABLES=false                  # change to 'true' if using an empty database
DB_AUTO_UPDATE=false                    # change to 'true' if using an empty database
RUN_OCL_IMPORT=false                    # Runs CIEL Concept on startup, takes ~30min
MODULE_WEB_ADMIN=true                   # allow web admin on OpenMRS
COPY_CFL_MODULES=true                   # Installs web/cfl-modules before startup

# Vxnaid Biometrics configuration
BIOMETRIC_ENABLE=true
BIOMETRIC_SERVER_HOST=127.0.0.1
BIOMETRIC_SERVER_ADMIN_PORT=24932
BIOMETRIC_SERVER_CLIENT_PORT=25452
BIOMETRIC_SERVER_MATCHING_THRESHOLD=40
BIOMETRIC_DB_HOST=localhost
BIOMETRIC_DB=iris_newpoc
BIOMETRIC_DB_PORT=3306
BIOMETRIC_DB_USERNAME=cfl_demo_iris
BIOMETRIC_DB_PASSWORD=Admin123
BIOMETRIC_DB_FETCH_SIZE=1000
